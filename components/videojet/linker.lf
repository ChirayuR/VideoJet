[mapping:videojet]
archive: libvideojet.a
entries:
    if VJ_IRAM = y:
        * (noflash)
        # Cold code: once per SPS/PPS NAL (the AA stream: per IDR) or error, not per MB or per slice. Flash keeps internal RAM for hot code.
        h264bsd_conceal (default)
        h264bsd_seq_param_set (default)
        h264bsd_pic_param_set (default)
        h264bsd_vui (default)
        # NAL extraction: once per NAL (one call per slice), its word loop runs from the I-cache. The internal RAM budget (R12).
        h264bsd_byte_stream (default)
    else:
        * (default)
